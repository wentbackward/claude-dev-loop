{
  "base_branch": "main",
  "remote": "origin",
  "fast_check": "make lint",
  "checks": [
    { "name": "check", "command": "make check", "summary": "Validation (passed|failed)|^(smoke|identity): " }
  ],
  "heavy": { "slots": 2, "memory_max": "4G" },
  "stop_gate": { "require_clean_tree": true, "max_blocks": 5 },
  "merge": { "method": "squash", "delete_branch": true, "delete_local": true },
  "cleanup": { "stale_days": 14, "keep_days": 30 },
  "models": {
    "implementer": "inherit",
    "code-reviewer": "sonnet",
    "test-engineer": "sonnet",
    "verifier": "haiku"
  }
}
