#!/usr/bin/env bash
# A stand-in for the GitHub CLI, for the smoke tests: PRs live in $FAKE_GH_DIR, a squash merge is a real
# squash commit pushed to the local bare origin. Every call is logged with the identity (GH_TOKEN) it ran
# as. Like GitHub, a PR author cannot approve its own PR, and a merge needs an approval when
# FAKE_GH_REQUIRE_APPROVAL=1. PRs get numbers in creation order; issues come from $FAKE_GH_DIR/issues.tsv
# ("<number>\t<state>\t<reason>[\t<createdAt>]"). `pr list` and `issue list` print the rows the scripts' --jq asks for.
# `auth status` succeeds once $FAKE_GH_DIR/logged-in exists. `gh api PATH` prints $FAKE_GH_DIR/api/<PATH with / as
# _> when it exists (else nothing); a <file>.fail next to it makes the call fail with its text, as gh does
# for an HTTP error ("gh: Not Found (HTTP 404)" on stderr, the body on stdout).
# Supports only what the plugin's scripts call.
set -u
dir=${FAKE_GH_DIR:?FAKE_GH_DIR not set}
mkdir -p "$dir"
who=${GH_TOKEN:-user}
echo "[$who] gh $*" >>"$dir/calls.log"
key() { printf '%s' "${1//\//_}"; }
case "${1:-} ${2:-}" in
  "pr view")
    branch=$3
    [ -f "$dir/$(key "$branch").state" ] || exit 1
    case "${5:-}" in
      state) cat "$dir/$(key "$branch").state" ;;
      reviewDecision) if [ -f "$dir/$(key "$branch").approved" ]; then echo APPROVED; else echo REVIEW_REQUIRED; fi ;;
      number) [ "${FAKE_GH_FAIL_NUMBER:-}" != 1 ] || exit 1; cat "$dir/$(key "$branch").number" ;;
      headRefOid) cat "$dir/$(key "$branch").head" ;;
      mergeCommit) cat "$dir/$(key "$branch").merge" 2>/dev/null ;;
    esac
    ;;
  "pr create")
    shift 2
    head="" title="" body_file=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --head) head=$2; shift 2 ;;
        --title) title=$2; shift 2 ;;
        --body-file) body_file=$2; shift 2 ;;
        *) shift ;;
      esac
    done
    printf '%s\n' "$title" >"$dir/$(key "$head").title"
    cp "$body_file" "$dir/$(key "$head").body"
    echo "$who" >"$dir/$(key "$head").author"
    echo OPEN >"$dir/$(key "$head").state"
    count=$(($(cat "$dir/count" 2>/dev/null || echo 0) + 1))
    echo "$count" >"$dir/count"
    echo "$count" >"$dir/$(key "$head").number"
    echo "$head" >"$dir/$(key "$head").name"
    git rev-parse "origin/$head" >"$dir/$(key "$head").head" 2>/dev/null || true
    ;;
  "pr list")
    for name_file in "$dir"/*.name; do
      [ -f "$name_file" ] || continue
      pr=${name_file%.name}
      printf '%s\t%s\t%s\t%s\n' "$(cat "$name_file")" "$(cat "$pr.head")" "$(cat "$pr.state")" "$(cat "$pr.number")"
    done
    ;;
  "issue list")
    # The rows have a fourth column, createdAt, printed only when the call asks for it.
    columns=3
    case " $* " in *createdAt*) columns=4 ;; esac
    [ ! -f "$dir/issues.tsv" ] ||
      awk -F'\t' -v OFS='\t' -v n="$columns" '{ out = $1; for (i = 2; i <= n; i++) out = out OFS $i; print out }' "$dir/issues.tsv"
    ;;
  "pr review")
    branch=$3
    [ "$(cat "$dir/$(key "$branch").author" 2>/dev/null)" != "$who" ] ||
      { echo "fake gh: cannot approve your own pull request" >&2; exit 1; }
    case " $* " in *" --approve "*) echo "$who" >"$dir/$(key "$branch").approved" ;; esac
    ;;
  "pr close")
    branch=$3
    [ -f "$dir/$(key "$branch").state" ] || exit 1
    comment=$(printf '%s\n' "$@" | grep -A1 -- --comment | tail -1)
    printf '%s\n' "$comment" >"$dir/$(key "$branch").comment"
    echo CLOSED >"$dir/$(key "$branch").state"
    ;;
  "pr merge")
    branch=$3
    if [ "${FAKE_GH_REQUIRE_APPROVAL:-}" = 1 ] && [ ! -f "$dir/$(key "$branch").approved" ]; then
      echo "fake gh: approval required" >&2
      exit 1
    fi
    origin=$(git remote get-url origin)
    expected=""
    [[ " $* " == *" --match-head-commit "* ]] && expected=$(printf '%s\n' "$@" | grep -A1 -- --match-head-commit | tail -1)
    work=$(mktemp -d)
    git clone -q "$origin" "$work/clone"
    (
      cd "$work/clone" || exit 1
      [ -z "$expected" ] || [ "$(git rev-parse "origin/$branch")" = "$expected" ] || { echo "fake gh: head moved" >&2; exit 1; }
      git merge -q --squash "origin/$branch" >/dev/null
      git commit -q -m "$(cat "$dir/$(key "$branch").title")"
      git push -q origin HEAD:main
      git rev-parse HEAD >"$dir/$(key "$branch").merge"
      git rev-parse "origin/$branch" >"$dir/$(key "$branch").head"
    ) || { rm -rf "$work"; exit 1; }
    rm -rf "$work"
    echo MERGED >"$dir/$(key "$branch").state"
    ;;
  "auth status")
    [ -f "$dir/logged-in" ] || { echo "fake gh: not logged in" >&2; exit 1; }
    ;;
  "api "*)
    printf '%s\n' "$*" >>"$dir/api.log"
    shift
    path=""
    while [ $# -gt 0 ]; do
      case $1 in
        -X | --method | -f | -F | --field | --raw-field | --input | --jq | -H | --header) shift 2 ;;
        -*) shift ;;
        *) path=$1; break ;;
      esac
    done
    canned="$dir/api/$(key "$path")"
    [ -f "$canned" ] || exit 0
    cat "$canned"
    [ ! -f "$canned.fail" ] || { echo "gh: $(cat "$canned.fail")" >&2; exit 1; }
    ;;
  *) echo "fake gh: unsupported: $*" >&2; exit 1 ;;
esac
