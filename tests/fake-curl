#!/usr/bin/env python3
"""A stand-in for curl, for the identity tests: answers the GitHub API calls the scripts make.

Local URLs (127.0.0.1) go to the real curl ($REAL_CURL). State lives in $FAKE_CURL_DIR.
"""

import base64
import json
import os
import subprocess
import sys

state = os.environ["FAKE_CURL_DIR"]
os.makedirs(state, exist_ok=True)
args = sys.argv[1:]
url = next((a for a in args if a.startswith(("http://", "https://"))), "")
if url.startswith("http://127.0.0.1"):
    os.execv(os.environ["REAL_CURL"], [os.environ["REAL_CURL"], *args])
headers = [args[i + 1] for i, a in enumerate(args) if a == "-H" and i + 1 < len(args)]
auth = next((h.split(" ", 2)[2] for h in headers if h.startswith("Authorization: Bearer ")), "")
with open(os.path.join(state, "calls.log"), "a", encoding="utf-8") as log:
    log.write(url + "\n")


def jwt_issuer(token: str) -> str:
    """The iss claim of a JWT (the signature is checked by the test with the public key)."""
    payload = token.split(".")[1]
    payload += "=" * (-len(payload) % 4)
    return str(json.loads(base64.urlsafe_b64decode(payload))["iss"])


def answer(value: object) -> None:
    print(json.dumps(value))
    sys.exit(0)


path = url.split("://", 1)[1].split("/", 1)[1] if "://" in url else ""
if "/conversions" in path:
    code = path.split("/")[1]
    role = code.removeprefix("code-dev-loop-").rsplit("-", 1)[0]
    ids_file = os.path.join(state, "next-id")
    app_id = int(open(ids_file).read()) if os.path.exists(ids_file) else 100
    open(ids_file, "w").write(str(app_id + 1))
    pem = subprocess.run(["openssl", "genrsa", "2048"], capture_output=True, text=True, check=True).stdout
    slug = f"dev-loop-{role}-owner"
    open(os.path.join(state, f"slug-{slug}"), "w").write(str(app_id))
    answer({"id": app_id, "slug": slug, "name": slug, "html_url": f"https://github.com/apps/{slug}",
            "pem": pem, "client_secret": "not-stored", "webhook_secret": None})
if path.endswith("/installation"):
    app_id = jwt_issuer(auth)
    if os.path.exists(os.path.join(state, f"installed-{app_id}")):
        answer({"id": 9000 + int(app_id)})
    sys.exit(22)
if path.startswith("app/installations/") and path.endswith("/access_tokens"):
    installation = path.split("/")[2]
    answer({"token": f"ghs_installation_{installation}", "expires_at": "2099-01-01T00:00:00Z"})
if path.startswith("users/") and path.endswith("%5Bbot%5D"):
    answer({"id": 4242, "login": path.split("/")[1]})
if path.startswith("users/"):
    answer({"type": "User"})
sys.exit(22)
