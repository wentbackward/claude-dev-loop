{
  "permissions": {
    "deny": [
      "Bash(sudo:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard origin:*)",
      "Bash(rm -rf /:*)",
      "Bash(rm -rf ~:*)",
      "Bash(gh repo delete:*)",
      "Bash(gh pr merge --admin:*)",
      "Bash(gh auth token:*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Read(~/.config/dev-loop/**)",
      "Edit(~/.config/dev-loop/**)",
      "Read(~/.dev-loop/*/dev-loop-tokens/**)",
      "Read(//run/user/**/dev-loop-tokens/**)"
    ]
  },
  "enabledPlugins": {
    "dev-loop@claude-dev-loop": true
  }
}
