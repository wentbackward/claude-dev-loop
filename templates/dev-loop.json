{
  "base_branch": "main",
  "remote": "origin",
  "fast_check": "make fmt-check lint",
  "format": "uv run --quiet ruff format {file}",
  "format_extensions": [".py"],
  "checks": [
    { "name": "check", "command": "make check", "summary": "passed|failed|coverage" },
    { "name": "e2e", "command": "make e2e", "summary": "passed|failed" },
    { "name": "docs", "command": "make docs-check", "heavy": false }
  ],
  "affected": "",
  "parallel": false,
  "fail_fast": false,
  "gate_setup": "",
  "gate_worktree": "",
  "notes_dir": "",
  "logs_dir": "",
  "heavy": {
    "slots": 2,
    "memory_max": "8G",
    "port_env": "E2E_PORT",
    "port_base": 8600,
    "port_step": 10,
    "clean_temp": [],
    "clean_temp_minutes": 120
  },
  "stop_gate": { "require_clean_tree": true, "max_blocks": 5 },
  "merge": { "method": "squash", "delete_branch": true, "delete_local": true },
  "cleanup": { "stale_days": 14, "keep_days": 30 },
  "models": {
    "implementer": "inherit",
    "code-reviewer": "sonnet",
    "test-engineer": "sonnet",
    "verifier": "haiku",
    "doc-auditor": "sonnet",
    "architect": "opus"
  },
  "deploy": "",
  "docs": {
    "aspects": {},
    "planned": "",
    "map": [],
    "max_lines": 1000,
    "journals": ["docs/DECISIONS.md"],
    "prd": [],
    "audit_every": 10,
    "planned_max_days": 0
  },
  "architecture": {
    "cards": "docs/architecture/",
    "check": "",
    "baseline": "docs/architecture/baseline.txt",
    "budget": 0,
    "cadence": 20,
    "scatter": 3,
    "growth": 500,
    "co_change": 75,
    "co_change_min": 3,
    "hotspot": 5,
    "cycle": 3,
    "fan_out": 5,
    "review_rounds": 3
  }
}
