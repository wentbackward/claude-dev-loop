{
  "name": "dev-loop-gate-{{OWNER}}",
  "description": "Gate: after a green batch run posts the required commit status, replays gated branches and merges.",
  "url": "https://github.com/{{REPO}}",
  "hook_attributes": {
    "url": "https://example.invalid/dev-loop-no-webhook",
    "active": false
  },
  "redirect_url": "{{REDIRECT_URL}}",
  "public": false,
  "default_permissions": {
    "contents": "write",
    "pull_requests": "write",
    "statuses": "write",
    "metadata": "read"
  },
  "default_events": []
}
